# Copy to .env and fill in. .env is gitignored; never commit real values.
# In GitHub Actions, set these as repository secrets with the same names.

# Discord channel webhook (Channel settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=

# Google Sheet logging is off unless this is exactly "true"
SHEET_ENABLED=false

# Apps Script web app URL, ending in /exec (Deploy > Manage deployments)
GOOGLE_SHEET_WEBHOOK=

# Adzuna (https://developer.adzuna.com/) - optional
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
